{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "globalSetup": "<rootDir>/test/support/e2e-global-setup.ts",
  "globalTeardown": "<rootDir>/test/support/e2e-global-teardown.ts",
  "setupFiles": ["<rootDir>/test/support/e2e-setup-env.ts"],
  "testTimeout": 30000,
  "collectCoverageFrom": ["src/**/*.ts", "!src/main.ts", "!src/**/*.module.ts", "!src/**/dto/**"],
  "coverageDirectory": "<rootDir>/coverage-e2e"
}
